# Uurroosterapp MCP Server — kopieer naar .env en vul in

# Backend API URL (lokaal of productie)
API_URL=http://localhost:3001/api/v1

# Admin credentials voor JWT ophalen
ADMIN_EMAIL=admin@hetvlot.be
ADMIN_PASSWORD=jouw_wachtwoord_hier

# PostgreSQL (zelfde als backend DATABASE_URL)
DATABASE_URL=postgresql://localhost/uurroosterapp
