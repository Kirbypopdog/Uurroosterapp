# Uurroosterapp MCP Server — kopieer naar .env en vul in

# Backend API URL (Render productie of lokaal)
API_URL=https://jouw-app.onrender.com/api/v1

# Admin credentials voor JWT ophalen
ADMIN_EMAIL=admin@hetvlot.be
ADMIN_PASSWORD=jouw_wachtwoord_hier

# PostgreSQL — gebruik de "External Database URL" van Render
DATABASE_URL=postgresql://user:pass@...render.com/uurroosterapp

# Optionele API key om de MCP server te beveiligen (aanbevolen!)
# Stel dit in als een willekeurig lang wachtwoord
MCP_API_KEY=kies_een_lang_willekeurig_wachtwoord

# Poort (Render stelt dit automatisch in)
# PORT=3002
